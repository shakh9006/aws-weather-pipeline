{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Access",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::weather-pipeline-bronze-ap-south-1-dev",
        "arn:aws:s3:::weather-pipeline-bronze-ap-south-1-dev/*",
        "arn:aws:s3:::weather-pipeline-silver-ap-south-1-dev",
        "arn:aws:s3:::weather-pipeline-silver-ap-south-1-dev/*",
        "arn:aws:s3:::weather-pipeline-athena-ap-south-1-dev",
        "arn:aws:s3:::weather-pipeline-athena-ap-south-1-dev/*"
      ]
    },
    {
      "Sid": "GlueCatalogAccess",
      "Effect": "Allow",
      "Action": [
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:CreatePartition",
        "glue:BatchCreatePartition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AthenaAccess",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetWorkGroup",
        "athena:StopQueryExecution"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SNSAccess",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-south-1:423623828360:weather-pipeline-sns-dev"
    }
  ]
}
